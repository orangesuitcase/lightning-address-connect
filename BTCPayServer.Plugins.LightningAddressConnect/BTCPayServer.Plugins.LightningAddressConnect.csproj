<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Product>Lightning Address Connect</Product>
        <Description>Connect any LUD-21 Lightning Address as your BTCPay Lightning backend — no node, no API key. Paste your address and receive payments directly into your wallet.</Description>
        <Version>1.0.0</Version>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RootNamespace>BTCPayServer.Plugins.LightningAddressConnect</RootNamespace>
        <AssemblyName>BTCPayServer.Plugins.LightningAddressConnect</AssemblyName>
    </PropertyGroup>

    <PropertyGroup>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <PreserveCompilationContext>false</PreserveCompilationContext>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <ProjectReference>
            <Properties>StaticWebAssetsEnabled=false</Properties>
            <Private>false</Private>
            <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
        </ProjectReference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**" />
        <ProjectReference Include="..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Views\Shared\LightningAddressConnect\LNPaymentMethodSetupTab.cshtml" />
    </ItemGroup>

</Project>
