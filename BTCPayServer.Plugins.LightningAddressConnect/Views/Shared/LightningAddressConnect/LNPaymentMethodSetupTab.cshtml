@model BTCPayServer.Models.StoreViewModels.LightningNodeViewModel
@{
    if (Model.CryptoCode != "BTC")
    {
        return;
    }
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const customNodeAccordian = document.getElementById("CustomNodeSupport");
        const template = document.getElementById("lightning-address-connect");
        if (customNodeAccordian && template) {
            customNodeAccordian.appendChild(template.content.cloneNode(true));
        }
    });
</script>

<template id="lightning-address-connect">
    <div class="accordion-item">
        <h2 class="accordion-header" id="CustomLightningAddressConnectHeader">
            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#CustomLightningAddressConnectContent" aria-controls="CustomLightningAddressConnectContent" aria-expanded="false">
                <span><strong>Lightning Address Connect</strong> setup</span>
                <vc:icon symbol="caret-down"/>
            </button>
        </h2>
        <div id="CustomLightningAddressConnectContent" class="accordion-collapse collapse" aria-labelledby="CustomLightningAddressConnectHeader" data-bs-parent="#CustomNodeSupport">
            <div class="accordion-body">
                <p class="my-2">
                    Receive Lightning payments directly into your own wallet. Paste your Lightning Address — no node, no API key.
                    BTCPay creates invoices via LNURL-pay and detects settlement with <strong>LUD-21 verify</strong>.
                </p>
                <p class="my-2">Connection string:</p>
                <ul class="pb-2">
                    <li>
                        <code><b>type=</b>lnaddress;<b>ln-address=</b>you@getalby.com</code>
                    </li>
                </ul>
                <p class="my-2">Click <strong>Test connection</strong> — BTCPay will probe the address and reject it if LUD-21 verify is missing.</p>

                <p class="my-2 mb-1"><strong>Supported (LUD-21)</strong></p>
                <ul class="pb-2">
                    <li><strong>Alby</strong> — <code>you@getalby.com</code></li>
                    <li><strong>Blink</strong> — <code>you@blink.sv</code> (or use the Blink plugin for Stablesats / API key)</li>
                    <li><strong>Speed</strong> — <code>you@speed.app</code></li>
                    <li><strong>Stacker News</strong> — <code>you@stacker.news</code></li>
                    <li><strong>LNbits</strong> / <strong>BTCPay</strong> / other self-hosted LNURL stacks with verify enabled</li>
                </ul>

                <p class="my-2 mb-1"><strong>Not supported yet</strong> (LNURL works, but no LUD-21 <code>verify</code>)</p>
                <ul class="pb-2">
                    <li>
                        <strong>Strike</strong> (<code>@@strike.me</code>) —
                        Use the dedicated Strike BTCPay plugin with your API key for now.
                        We’ll add address support when Strike offers LUD-21 verify.
                    </li>
                    <li>
                        <strong>Wallet of Satoshi</strong> (<code>@@walletofsatoshi.com</code>) /
                        <strong>Coinos</strong> (<code>@@coinos.io</code>) —
                        We’ll add them as soon as their addresses return LUD-21 verify
                        (needed so BTCPay can detect when a payment settles).
                    </li>
                </ul>

                <p class="my-2 text-muted">
                    Receive-only. Native amountless BOLT11 is not supported; crowdfund/fundraising works when LNURL is enabled on the store.
                    Settlement is polled (typically seconds, up to about a minute). Clearnet only (no Tor <code>.onion</code> addresses).
                </p>
            </div>
        </div>
    </div>
</template>
